# LujanDev API — Ejemplo de configuración
# Este archivo documenta variables de entorno.
# No incluir contraseñas, tokens ni credenciales reales.

# Raffle Lab
# Activa la expiración automática de reservas cada minuto.
# Desactivado por defecto.
RAFFLE_LAB_CRON_ENABLED=false

# Control global de tareas programadas.
# Si se establece en false, desactiva también el cron de Raffle Lab.
# ENABLE_CRON_JOBS=false
